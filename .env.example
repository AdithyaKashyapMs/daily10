# Copy to .env. Free key: https://console.groq.com
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=            # optional second key

# DAILY10_MODEL=openai/gpt-oss-120b
# DAILY10_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# DAILY10_JUDGE_MODEL=qwen/qwen3.8-27b   # grades question quality (evals)

# STUDY_DATABASE_URL=sqlite:///daily10.sqlite     # or postgresql+psycopg://...
# STUDY_ADMIN_KEY=                                # university invite code for faculty sign-up
STUDY_TIMEZONE=Asia/Kolkata                        # the college's timezone: when "today" starts
STUDY_APP_URL=http://localhost:3000/today          # link in reminder messages

# Student sign-in: college email + password. "Forgot password?" emails a reset link; without
# SMTP_HOST the link is printed in the API's terminal instead.
# STUDY_STUDENT_EMAIL_DOMAINS=uvce.ac.in
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD= SMTP_FROM=

# Telegram reminders: python -m daily10.notify serve
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
