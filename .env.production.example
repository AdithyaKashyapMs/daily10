# Production settings. Copy to .env.production on the server (never commit it), fill in, then:
#   docker compose --env-file .env.production up -d --build

# Your HTTPS address. Point its DNS A record at the server first.
DOMAIN=daily10.yourcollege.edu

# Database password (any long random string: openssl rand -hex 24)
POSTGRES_PASSWORD=

# University invite code: faculty need it to create an account (openssl rand -hex 16)
STUDY_ADMIN_KEY=

# LLM (free keys from console.groq.com)
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=

# Students sign in with an email on these domains (comma-separated; subdomains allowed)
STUDY_STUDENT_EMAIL_DOMAINS=yourcollege.edu

# The college's timezone: decides when "today" starts and when reminders go out
STUDY_TIMEZONE=Asia/Kolkata

# Email for password-reset links: the college mail server or any SMTP provider (SES, Brevo, Resend...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Daily 10 <daily10@yourcollege.edu>

# Telegram reminders (optional): create a bot with @BotFather, then start with --profile telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
